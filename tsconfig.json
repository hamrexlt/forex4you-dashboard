{
	"extends": "adonis-preset-ts/tsconfig.json",
	"exclude": ["node_modules", "build"],
	"include": ["**/*"],

	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"esModuleInterop": true,
		"outDir": "build",
		"rootDir": "./",

		"skipLibCheck": true,
		"baseUrl": "./",
		"resolveJsonModule": true,
		"sourceMap": false,
		"paths": {
			"App/*": ["./app/*"],
			"Config/*": ["./config/*"],
			"Contracts/*": ["./contracts/*"],
			"Database/*": ["./database/*"],
			"@/*": ["./resources/js/*"]
		},
		"lib": ["DOM", "ES2024"],
		"types": [
			"@adonisjs/core",
			"@adonisjs/repl",
			"@adonisjs/session",
			"@adonisjs/view",
			"@adonisjs/shield",
			"@japa/preset-adonis/build/adonis-typings",
			"@adonisjs/lucid",
			"@adonisjs/auth",
			"@adonisjs/mail",
			"@verful/notifications",
			"@adonisjs/bouncer",
			"jquery"
		],
		"jsx": "react-jsx"
	}
}
